# --- Engine (engopt fuelflow format) ---
# Layout (per FreeFalcon AirframeEngineRead):
#   engopt [options...]
#   thrustFactor  fuelFlowFactor
#   numMach
#   mach[0..numMach-1]
#   numAlt
#   alt[0..numAlt-1]
#   thrust_idle[alt=0][mach=0..numMach-1]   <- alt is OUTER, mach is INNER
#   thrust_idle[alt=1][...]
#   ... (numAlt rows)
#   thrust_mil[...]   (numAlt rows)
#   thrust_ab[...]    (numAlt rows)
#   fuelflow_idle[...] (only if engopt fuelflow)
#   fuelflow_mil[...]
#   fuelflow_ab[...]
engopt fuelflow
