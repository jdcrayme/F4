-GeoQuad make_quad(const f4::geo::WorldPosition& p0,
-                  const f4::geo::WorldPosition& p1,
-                  const f4::geo::WorldPosition& p2,
-                  const f4::geo::WorldPosition& p3,
-                  const float color[4]) {
-    GeoQuad q;
-    q.p[0] = p0; q.p[1] = p1; q.p[2] = p2; q.p[3] = p3;
-    set_color(&q.r, color);
-    return q;
-}
