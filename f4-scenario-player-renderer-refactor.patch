+// ── load_world_json ────────────────────────────────────────────────────────
+void PlayerApp::load_world_json(const std::filesystem::path& world_json_path) {
+    // Load the world state from JSON.
+    f4::world::WorldState ws;
+    ws.load(world_json_path);
+
+    // Populate the entity world and find the first airbase with ground layout.
+    f4::entities::EntityWorld eworld;
+    auto populated = f4::world::populate_world(eworld, ws);
+
+    // Search for an objective with GroundLayoutComponent.
+    const auto& obj_ids = eworld.with_tag_ref(
+        f4::entities::tags::ROLE,
+        f4::entities::TagValue::from(std::string("objective")));
+
+    for (const auto& eid : obj_ids) {
+        auto h = f4::entities::EntityHandle(eid, &eworld);
+        auto* gl = h.get<f4::entities::GroundLayoutComponent>();
+        if (gl && !gl->layouts.empty()) {
+            // Found an airbase with real ground layout data.
+            auto* fs = h.get<f4::entities::FeatureSetComponent>();
+            const auto* features = fs ? &fs->features : nullptr;
+
+            impl_->airfield_geometry = f4::renderer::build_airfield_geometry_3d(
+                gl->layouts, features);
+            impl_->airfield_geometry_built = true;
+
+            impl_->status_msg = "Real airfield geometry loaded from world (" +
+                std::to_string(gl->layouts.size()) + " layout lists)";
+            return;
+        }
+    }
+
+    // No airbase found with ground layout.
+    impl_->status_msg = "No airbase with ground layout found in world JSON";
+}
+
+// ── build_airfield_from_scenario ───────────────────────────────────────────
+void PlayerApp::Impl::build_airfield_from_scenario() {
+    // Convert the scenario's airfield block into GroundLayoutList format
+    // so we can use the shared f4::renderer::build_airfield_geometry_3d().
+    //
+    // The scenario provides:
+    //   - threshold_position / runway_end_position → runway centerline
+    //   - taxi_route waypoints → taxiway path
+    //
+    // We synthesize GroundLayoutList entries that match the PHD format.
+
+    if (scenario.airfield.taxi_route.empty()) {
+        airfield_geometry_built = true;  // empty but marked built
+        return;
+    }
+
+    std::vector<f4::entities::GroundLayoutList> layouts;
+
+    // Runway centerline (type = PLT_RUNWAY = 1)
+    {
+        f4::entities::GroundLayoutList cl;
+        cl.type = 1;  // PLT_RUNWAY
+        cl.runway_num = 0;
+        cl.heading_deg = static_cast<float>(std::atan2(
+            scenario.airfield.runway_end_position.x - scenario.airfield.threshold_position.x,
+            scenario.airfield.runway_end_position.y - scenario.airfield.threshold_position.y
+        ) * 180.0 / 3.14159265358979);
+        f4::entities::GroundLayoutPoint thr;
+        thr.x = static_cast<float>(scenario.airfield.threshold_position.x);
+        thr.y = static_cast<float>(scenario.airfield.threshold_position.y);
+        f4::entities::GroundLayoutPoint end;
+        end.x = static_cast<float>(scenario.airfield.runway_end_position.x);
+        end.y = static_cast<float>(scenario.airfield.runway_end_position.y);
+        cl.points = {thr, end};
+        cl.count = static_cast<uint8_t>(cl.points.size());
+        layouts.push_back(cl);
+    }
+
+    // Taxi route (type = PLT_TRACK = 17, treated as taxiway)
+    if (scenario.airfield.taxi_route.size() >= 2) {
+        f4::entities::GroundLayoutList taxi;
+        taxi.type = 17;  // PLT_TRACK
+        taxi.runway_num = 255;  // not a runway
+        taxi.heading_deg = 0.0f;
+        for (const auto& wp : scenario.airfield.taxi_route) {
+            f4::entities::GroundLayoutPoint pt;
+            pt.x = static_cast<float>(wp.x);
+            pt.y = static_cast<float>(wp.y);
+            taxi.points.push_back(pt);
+        }
+        taxi.count = static_cast<uint8_t>(taxi.points.size());
+        layouts.push_back(taxi);
+    }
+
+    // Parking Spot (type = PLT_PARK = 11)
+    if (!scenario.aircraft.empty()) {
+        f4::entities::GroundLayoutList park;
+        park.type = 11;  // PLT_PARK
+        park.runway_num = 255;
+        park.heading_deg = 0.0f;
+        const auto& ps = scenario.aircraft.front().parking_spot;
+        f4::entities::GroundLayoutPoint pt;
+        pt.x = static_cast<float>(ps.x);
+        pt.y = static_cast<float>(ps.y);
+        park.points = {pt};
+        park.count = static_cast<uint8_t>(park.points.size());
+        layouts.push_back(park);
+    }
+
+    airfield_geometry = f4::renderer::build_airfield_geometry_3d(layouts);
+    airfield_geometry_built = true;
+}
