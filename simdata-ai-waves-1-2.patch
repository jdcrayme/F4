+/// -90/+90/+90 deg; the 2-ship slot inherits slot[0] (num2Slots == 0).
+f4::data::Formation spread_formation() {
+    f4::data::Formation f;
+    f.name = "spread";
+    f.form_num = 0;
+    f.two_ship = f4::data::FormationSlot{-90.0, 0.0, 0.5, 0};
+    f.two_ship_explicit = false;
+    f.slots = {
+        {-90.0, 0.0, 0.5, 0},
