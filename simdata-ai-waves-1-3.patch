+    ///     files store cx NEGATIVE for drag — aero.cpp:53 xaero = cx*qsom
+    ///     decelerates the +x body axis; a single reference condition
+    ///     stands in for the mach x alpha grid, documented)
+    ///   - max speed: drag-limited terminal speed sqrt(2T/(rho0*cd*A))
+    ///     at sea level (a data-derived envelope cap; 0 when not derivable)
+    ///   - seeker cone: atamax — the "# Field of View (deg)" input field,
+    ///     already radians in f4-data (readin.cpp:117 xDTR)
+    ///   - seeker range: the WEZ table's maximum value (the kinematic
+    ///     envelope as a stand-in — Falcon4's seeker range lives in the
+    ///     WCD class table, NOT in MISDATA)
+    ///   - fuze radius: aux proximityfuserange (default 1000 ft)
+    ///   - lethal radius: 0.0 — warhead lethality lives in the WCD class
+    ///     table; hosts set it from their WeaponClassRecord
+    ///   - tof limit: maxTof (status.cpp:52 runTime > maxTof)
+    ///   - PN gain: mslGnav — the proportional-navigation gain
+    ///   - max g: aux maxGNormal (default 40)
+    [[nodiscard]] static MissileConfig from_simdata(
+        const f4::data::MissileDataset& dataset);
