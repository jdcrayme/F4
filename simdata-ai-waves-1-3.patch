+// f4-data/src/sensor_data.cpp
+//
+// Sensor data lookups + canonical JSON serialization (three families:
+// f4.irstdata / f4.rwrdata / f4.visualdata, all version 1).
+
+#include "f4/data/sensor_data.hpp"
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <fstream>
+#include <sstream>
+
+namespace f4::data {
