+// ---------------------------------------------------------------------------
+// find() overloads
+// ---------------------------------------------------------------------------
+const IrstSensorEntry* IrstSensorData::find(
+    std::string_view name) const noexcept {
+    const std::string want = canonicalName(name);
+    for (const auto& e : sensors) {
+        if (canonicalName(e.name) == want) return &e;
+    }
+    return nullptr;
+}
