new file mode 100644
index 0000000..b732c1a
--- /dev/null
+++ b/f4-data/src/missile_data.cpp
@@ -0,0 +1,548 @@
+// f4-data/src/missile_data.cpp
+//
+// Missile dataset interpolation accessors (the aero.cpp / engine.cpp /
+// missmain.cpp lookup contracts) + canonical JSON serialization
+// (f4.misdata v1).
+
+#include "f4/data/missile_data.hpp"
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <fstream>
+#include <sstream>
+
+namespace f4::data {
+
+using json = nlohmann::json;
+
+namespace {
+
+std::string canonicalName(std::string_view s) {
+    std::string out;
+    out.reserve(s.size());
+    for (char c : s) {
+        out.push_back(
+            static_cast<char>(std::tolower(static_cast<unsigned char>(c))));
+    }
+    return out;
+}
+
+/// Index of the first breakpoint > v, clamped; `lo` receives the bracket
+/// start index. Ascending input assumed (empty handled by caller).
+[[nodiscard]] std::size_t bracketIndex(const std::vector<double>& axis,
+                                       double v,
+                                       std::size_t& lo) noexcept {
+    const auto it = std::upper_bound(axis.begin(), axis.end(), v);
+    std::size_t hi = static_cast<std::size_t>(it - axis.begin());
+    if (hi == 0) {
+        lo = 0;
+        return 0;
+    }
+    if (hi >= axis.size()) {
+        hi = axis.size() - 1;
+        lo = hi;
+        return hi;
+    }
+    lo = hi - 1;
+    return hi;
+}
+
+[[nodiscard]] double axisFraction(double v, double lo, double hi) noexcept {
+    if (hi <= lo) return 0.0;
+    return std::clamp((v - lo) / (hi - lo), 0.0, 1.0);
+}
+
+/// Shared bilinear core for cx/cz (aero.cpp:36-46 TwodInterp over
+/// mach x alpha).
+[[nodiscard]] double bilinear(const std::vector<double>& machAxis,
+                              const std::vector<double>& alphaAxis,
+                              const std::vector<std::vector<double>>& table,
+                              double machV, double alphaV) noexcept {
+    if (machAxis.empty() || alphaAxis.empty() || table.empty()) return 0.0;
+    const double m = std::clamp(machV, machAxis.front(), machAxis.back());
+    const double a = std::clamp(alphaV, alphaAxis.front(), alphaAxis.back());
+    std::size_t mx = 0, ax = 0;
+    const std::size_t mxHi = bracketIndex(machAxis, m, mx);
+    const std::size_t axHi = bracketIndex(alphaAxis, a, ax);
+    const auto at = [&](std::size_t i, std::size_t j) -> double {
+        const auto& row = table[std::min(i, table.size() - 1)];
+        if (row.empty()) return 0.0;
+        return row[std::min(j, row.size() - 1)];
+    };
+    const double tx =
+        axisFraction(m, machAxis[mx], machAxis[std::min(mxHi, machAxis.size() - 1)]);
+    const double ty =
+        axisFraction(a, alphaAxis[ax], alphaAxis[std::min(axHi, alphaAxis.size() - 1)]);
+    // Bilinear over the four bracket corners. Axis order: rows = mach
+    // (tx), columns = alpha (ty) — v01 varies along alpha, v10 along
+    // mach.
+    const double v00 = at(mx, ax);
+    const double v01 = at(mx, axHi);
+    const double v10 = at(mxHi, ax);
+    const double v11 = at(mxHi, axHi);
+    return v00 * (1.0 - tx) * (1.0 - ty) + v01 * (1.0 - tx) * ty +
+           v10 * tx * (1.0 - ty) + v11 * tx * ty;
+}
+
+} // namespace
+
+// ---------------------------------------------------------------------------
+// Aero lookups
+// ---------------------------------------------------------------------------
+double MissileAeroData::cx_at(double machV, double alphaV) const noexcept {
+    return bilinear(mach, alpha, cx, machV, alphaV);
+}
+
+double MissileAeroData::cz_at(double machV, double alphaV) const noexcept {
+    return bilinear(mach, alpha, cz, machV, alphaV);
+}
+
+// ---------------------------------------------------------------------------
+// Engine lookup (engine.cpp:15-22)
+// ---------------------------------------------------------------------------
+double MissileEngineData::thrust_at(double t) const noexcept {
+    if (times_s.empty()) return 0.0;
+    // Hard zero after burnout — engine.cpp:18-22.
+    if (t >= times_s.back()) return 0.0;
+    if (t <= times_s.front()) return thrust_lbf.empty() ? 0.0
+                                                        : thrust_lbf.front();
+    std::size_t lo = 0;
+    const std::size_t hi = bracketIndex(times_s, t, lo);
+    const double f = axisFraction(t, times_s[lo],
+                                  times_s[std::min(hi, times_s.size() - 1)]);
+    if (thrust_lbf.empty()) return 0.0;
+    const double v0 = thrust_lbf[std::min(lo, thrust_lbf.size() - 1)];
+    const double v1 = thrust_lbf[std::min(hi, thrust_lbf.size() - 1)];
+    return v0 + (v1 - v0) * f;
+}
+
+double MissileEngineData::burn_time_s() const noexcept {
+    return times_s.empty() ? 0.0 : times_s.back();
+}
+
+// ---------------------------------------------------------------------------
+// Range / WEZ lookup (missmain.cpp:836-841 ThreedInterp)
+// ---------------------------------------------------------------------------
+double MissileRangeData::range_at(double alt, double vt,
+                                  double aspect) const noexcept {
+    if (alt_breakpoints_ft.empty() || vel_breakpoints_fps.empty() ||
+        aspect_breakpoints_rad.empty() || data_ft.empty()) {
+        return 0.0;
+    }
+    const double a = std::clamp(alt, alt_breakpoints_ft.front(),
+                                alt_breakpoints_ft.back());
+    const double v = std::clamp(vt, vel_breakpoints_fps.front(),
+                                vel_breakpoints_fps.back());
+    const double s = std::clamp(aspect, aspect_breakpoints_rad.front(),
+                                aspect_breakpoints_rad.back());
+
+    std::size_t ai = 0, vi = 0, si = 0;
+    const std::size_t aiHi = bracketIndex(alt_breakpoints_ft, a, ai);
+    const std::size_t viHi = bracketIndex(vel_breakpoints_fps, v, vi);
+    const std::size_t siHi = bracketIndex(aspect_breakpoints_rad, s, si);
+
+    const auto at = [&](std::size_t i, std::size_t j,
+                        std::size_t k) -> double {
+        const auto& plane = data_ft[std::min(i, data_ft.size() - 1)];
+        if (plane.empty()) return 0.0;
+        const auto& row = plane[std::min(j, plane.size() - 1)];
+        if (row.empty()) return 0.0;
+        return row[std::min(k, row.size() - 1)];
+    };
+
+    const auto frac = [](const std::vector<double>& axis, std::size_t lo,
+                         std::size_t hi, double x) noexcept {
+        return axisFraction(x, axis[lo],
+                            axis[std::min(hi, axis.size() - 1)]);
+    };
+    const double fa = frac(alt_breakpoints_ft, ai, aiHi, a);
+    const double fv = frac(vel_breakpoints_fps, vi, viHi, v);
+    const double fs = frac(aspect_breakpoints_rad, si, siHi, s);
+
+    // Trilinear: 2 bilinear planes along aspect, then lerp.
+    const double c00 = at(ai, vi, si);
+    const double c01 = at(ai, vi, siHi);
+    const double c10 = at(ai, viHi, si);
+    const double c11 = at(ai, viHi, siHi);
+    const double plane0 =
+        c00 * (1.0 - fv) + c10 * fv;  // at si
+    const double plane1 =
+        c01 * (1.0 - fv) + c11 * fv;  // at siHi
+    const double velLerp = plane0 * (1.0 - fs) + plane1 * fs;
+
+    const double d00 = at(aiHi, vi, si);
+    const double d01 = at(aiHi, vi, siHi);
+    const double d10 = at(aiHi, viHi, si);
+    const double d11 = at(aiHi, viHi, siHi);
+    const double qplane0 = d00 * (1.0 - fv) + d10 * fv;
+    const double qplane1 = d01 * (1.0 - fv) + d11 * fv;
+    const double velLerpHi = qplane0 * (1.0 - fs) + qplane1 * fs;
+
+    return velLerp * (1.0 - fa) + velLerpHi * fa;
+}
