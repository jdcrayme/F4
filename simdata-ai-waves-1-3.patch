+json aeroToJson(const MissileAeroData& a) {
+    json j;
+    j["mach"] = a.mach;
+    j["alpha_deg"] = a.alpha;
+    json czArr = json::array();
+    for (const auto& row : a.cz) czArr.push_back(row);
+    j["cz"] = std::move(czArr);
+    json cxArr = json::array();
+    for (const auto& row : a.cx) cxArr.push_back(row);
+    j["cx"] = std::move(cxArr);
+    return j;
+}
+
+MissileAeroData aeroFromJson(const json& j) {
+    MissileAeroData a;
+    if (j.contains("mach")) a.mach = j["mach"].get<std::vector<double>>();
+    if (j.contains("alpha_deg"))
+        a.alpha = j["alpha_deg"].get<std::vector<double>>();
+    for (const char* key : {"cz", "cx"}) {
+        if (!j.contains(key) || !j[key].is_array()) continue;
+        std::vector<std::vector<double>>* target =
+            key[0] == 'c' && key[1] == 'z' ? &a.cz : &a.cx;
+        for (const auto& row : j[key]) {
+            if (!row.is_array()) continue;
+            target->push_back(row.get<std::vector<double>>());
+        }
+    }
+    return a;
+}
