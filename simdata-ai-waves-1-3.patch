+            j["aspect_breakpoints_rad"].get<std::vector<double>>();
+    if (j.contains("data_ft") && j["data_ft"].is_array()) {
+        for (const auto& plane : j["data_ft"]) {
+            if (!plane.is_array()) continue;
+            std::vector<std::vector<double>> rows;
+            for (const auto& row : plane) {
+                if (!row.is_array()) continue;
