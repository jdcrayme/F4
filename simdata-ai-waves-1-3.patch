+MissileConfig MissileConfig::from_simdata(
+    const f4::data::MissileDataset& ds) {
+    MissileConfig c;
+    const auto& in = ds.input;
+
+    // Masses: readin.cpp:18-27 (MissileClass::ReadInput) — weight = wm0 +
+    // wp0 at launch; engine.cpp:64 keeps weight = wm0 + wprop, so burnout
+    // weight is wm0.
+    c.launch_mass_lb  = in.launch_weight_lb();
+    c.burnout_mass_lb = in.wm0_lb;
+
+    // Motor: burn time = the engine table's last breakpoint (status.cpp:46
+    // compares runTime against exactly that value); thrust = the
+    // single-thrust equivalent of the curve (trapezoid / burn time).
+    c.burn_time_s = ds.engine.burn_time_s();
+    double impulse = 0.0;
+    const auto& t = ds.engine.times_s;
+    const auto& f = ds.engine.thrust_lbf;
+    for (std::size_t i = 1; i < t.size() && i < f.size(); ++i) {
+        impulse += 0.5 * (f[i - 1] + f[i]) * (t[i] - t[i - 1]);
+    }
+    c.thrust_lbf = c.burn_time_s > 0.0 ? impulse / c.burn_time_s : 0.0;
+
+    // Drag: reference-condition cd from the cx grid. The shipped files
+    // store cx NEGATIVE for drag (aero.cpp:53), so cd = -cx(1, 0) >= 0.
+    c.ref_area_ft2 = in.area_ft2;
+    c.cd = std::max(0.0, -ds.aero.cx_at(1.0, 0.0));
+
+    // Envelope: drag-limited terminal speed at sea level, when derivable.
+    if (c.thrust_lbf > 0.0 && c.cd > 0.0 && c.ref_area_ft2 > 0.0) {
+        c.max_speed_fts = std::sqrt(
+            2.0 * c.thrust_lbf / (0.0023769 * c.cd * c.ref_area_ft2));
+    } else {
+        c.max_speed_fts = 0.0;
+    }
+
+    // Guidance/seeker: PN gain = mslGnav; cone = atamax (already radians);
+    // range = the WEZ table's max (kinematic-envelope stand-in — Falcon4's
+    // seeker range lives in the WCD class table, not MISDATA).
+    c.guidance_gain = in.nav_gain;
+    c.seeker_half_angle_rad = in.seeker_fov_rad;
+    double wezMax = 0.0;
+    for (const auto& plane : ds.range.data_ft) {
+        for (const auto& row : plane) {
+            for (double v : row) wezMax = std::max(wezMax, v);
+        }
+    }
+    c.seeker_max_range_ft = wezMax;
+
+    // Fuze/damage/endgame: proximity fuze from aux; lethality is WCD data
+    // (host sets it); self-destruct at maxTof (status.cpp:52).
+    c.fuze_radius_ft   = static_cast<double>(ds.aux.proximity_fuse_range_ft);
+    c.lethal_radius_ft = 0.0;
+    c.tof_limit_s      = in.max_tof_s;
+
+    // G limit: aux maxGNormal (the reader's default 40).
+    c.max_g = ds.aux.max_g_normal;
+
+    return c;
+}
+
