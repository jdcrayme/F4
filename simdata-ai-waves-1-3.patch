+// f4-convert/src/missile_parser.cpp
+//
+// Implementation of the MISDATA .dat parser (see missile_parser.hpp for
+// the format contract and the two documented quirks).
+//
+// Source fidelity anchors (ff-src/src/sim/missile/readin.cpp):
+//   - MissileInputRead   :91-154   the 39 GetNext() reads in order
+//   - MissileAeroRead    :156-247  breakpoints, multiplier-folded tables
+//   - MissileEngineRead  :249-289  time breakpoints then thrust
+//   - MissileRangeRead   :291-381  scale + three breakpoint axes + grid
+//   - MissileAuxAeroRead :452-465  key-value tail (ParseSimlibFile)
+// DTR (degrees->radians) multiplies gimlim/gmdmax/atamax at load
+// (readin.cpp:115-117); the port stores radians.
+
+#include "f4/convert/missile_parser.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace f4::convert {
+
+namespace fs = std::filesystem;
+
+namespace {
+
+constexpr double kDeg2Rad = 0.017453292519943295;  // DTR
+
+// --- tokenization: the SimlibFileClass::GetNext contract -------------
+
+struct Token {
+    std::string text;
+    std::size_t line;  // 1-based source line (for the aux tail boundary)
+};
+
+std::vector<Token> tokenize(const std::string& source) {
+    std::vector<Token> tokens;
+    std::size_t line = 1;
+    std::size_t i = 0;
+    while (i < source.size()) {
+        const char c = source[i];
+        if (c == '\n') {
+            ++line;
+            ++i;
+        } else if (c == '#' || c == ';') {
+            // GetNext: a comment token skips the REST OF THE LINE.
+            while (i < source.size() && source[i] != '\n') ++i;
+        } else if (std::isspace(static_cast<unsigned char>(c))) {
+            ++i;
+        } else {
+            std::string tok;
+            const std::size_t tokLine = line;
+            while (i < source.size() &&
+                   !std::isspace(static_cast<unsigned char>(source[i]))) {
+                tok.push_back(source[i]);
+                ++i;
+            }
+            tokens.push_back({std::move(tok), tokLine});
+        }
+    }
+    return tokens;
+}
+
+bool parseDouble(const std::string& tok, double& out) {
+    if (tok.empty()) return false;
+    char* end = nullptr;
+    out = std::strtod(tok.c_str(), &end);
+    return end != nullptr && *end == '\0';
+}
+
+/// atoi() semantics: leading integer prefix, garbage -> 0 (datafile.cpp
+/// AssignField is stricter, but the aero/range readers use atoi).
+bool atoiLike(const std::string& tok, long& out) {
+    std::size_t i = 0;
+    bool neg = false;
+    if (i < tok.size() && (tok[i] == '+' || tok[i] == '-')) {
+        neg = tok[i] == '-';
+        ++i;
+    }
+    std::size_t digits = 0;
+    long value = 0;
+    while (i < tok.size() && std::isdigit(static_cast<unsigned char>(tok[i]))) {
+        value = value * 10 + (tok[i] - '0');
+        ++i;
+        ++digits;
+    }
+    out = neg ? -value : value;
+    return digits > 0;  // false = no leading integer (atoi would give 0)
+}
+
+std::string lowercase(std::string s) {
+    std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) {
+        return static_cast<char>(std::tolower(c));
+    });
+    return s;
+}
+
+// --- the sequential reader core ---------------------------------------
+//
+// One pass over the token stream in reader order. `inputFields` selects
+// the input-section layout: 39 (FreeFalcon reader order) or 24 (the
+// shipped 1998 files; the fifteen guidance fields stay 0.0).
+
+struct ReaderState {
+    const std::vector<Token>& tokens;
+    std::size_t pos = 0;
+    std::vector<std::string>& errors;
+    const std::string src;
+    bool fail = false;
+
+    bool next(const char* what, std::string& out) {
+        if (fail) return false;
+        if (pos >= tokens.size()) {
+            errors.push_back(src + ": unexpected EOF in " + what);
+            fail = true;
+            return false;
+        }
+        out = tokens[pos].text;
+        ++pos;
+        return true;
+    }
+
+    bool nextDouble(const char* what, double& out) {
+        std::string t;
+        if (!next(what, t)) return false;
+        if (!parseDouble(t, out)) {
+            errors.push_back(src + ": " + what + " '" + t +
+                             "' is not a number");
+            fail = true;
+            return false;
+        }
+        return true;
+    }
+
+    bool nextInt(const char* what, long& out) {
+        std::string t;
+        if (!next(what, t)) return false;
+        if (!atoiLike(t, out)) {
+            errors.push_back(src + ": " + what + " '" + t +
+                             "' is not an integer");
+            fail = true;
+            return false;
+        }
+        return true;
+    }
+};
+
+bool implausibleCount(const char* what, long v, long lo, long hi) {
+    (void)what;
+    (void)lo;
+    (void)hi;
+    (void)v;
+    return v < lo || v > hi;
+}
+
+/// Sequentially read the five sections in reader order (readin.cpp
+/// :62-66). `inputFieldCount` = 39 or 24.
+bool readAll(ReaderState& r, f4::data::MissileDataset& ds,
+             std::size_t inputFieldCount, const std::string& src,
+             std::vector<std::string>& errors, std::size_t& lastTokenLine) {
+    using In = f4::data::MissileInputData;
+    In& in = ds.input;
+    long seekerType = 0, seekerVersion = 0, displayType = 0;
+
+    // ---- Input section (readin.cpp:91-154) ----
+    if (!r.nextDouble("max_tof", in.max_tof_s)) return false;
+    if (!r.nextDouble("pk", in.pk)) return false;
+    if (!r.nextDouble("wm0", in.wm0_lb)) return false;
+    if (!r.nextDouble("wp0", in.wp0_lb)) return false;
+    if (!r.nextDouble("total_impulse", in.total_impulse_lb_s)) return false;
+    if (!r.nextDouble("area", in.area_ft2)) return false;
+    if (!r.nextDouble("nozzle_area", in.nozzle_area_ft2)) return false;
+    if (!r.nextDouble("length", in.length_ft)) return false;
+    if (!r.nextDouble("aoa_max", in.aoa_max_deg)) return false;
+    if (!r.nextDouble("aoa_min", in.aoa_min_deg)) return false;
+    if (!r.nextDouble("beta_max", in.beta_max_deg)) return false;
+    if (!r.nextDouble("beta_min", in.beta_min_deg)) return false;
+    if (!r.nextDouble("v_min", in.v_min_fps)) return false;
+    // readin.cpp:115-117: these three are degrees in the file, radians
+    // in the struct (xDTR at load).
+    if (!r.nextDouble("gimbal_limit", in.gimbal_limit_rad)) return false;
+    in.gimbal_limit_rad *= kDeg2Rad;
+    if (!r.nextDouble("gimbal_rate_limit", in.gimbal_rate_limit_rad_s))
+        return false;
+    in.gimbal_rate_limit_rad_s *= kDeg2Rad;
+    if (!r.nextDouble("seeker_fov", in.seeker_fov_rad)) return false;
+    in.seeker_fov_rad *= kDeg2Rad;
+    if (!r.nextDouble("guidance_delay", in.guidance_delay_s)) return false;
+    if (!r.nextDouble("loft_bias", in.loft_bias)) return false;
+    if (!r.nextDouble("nav_gain", in.nav_gain)) return false;
+    if (!r.nextDouble("autopilot_bandwidth", in.autopilot_bandwidth))
+        return false;
+    if (!r.nextDouble("active_ttg", in.active_ttg_s)) return false;
+    if (!r.nextInt("seeker_type", seekerType)) return false;
+    in.seeker_type = static_cast<int>(seekerType);
+    if (!r.nextInt("seeker_version", seekerVersion)) return false;
+    in.seeker_version = static_cast<int>(seekerVersion);
+    if (!r.nextInt("display_type", displayType)) return false;
+    in.display_type = static_cast<int>(displayType);
+    if (inputFieldCount == 39) {
+        if (!r.nextDouble("loft_time", in.loft_time_s)) return false;
+        if (!r.nextDouble("boost_guide_s", in.boost_guide_s)) return false;
+        if (!r.nextDouble("terminal_guide_range", in.terminal_guide_range))
+            return false;
+        if (!r.nextDouble("boost_guide_precision", in.boost_guide_precision))
+            return false;
+        if (!r.nextDouble("sustain_guide_precision",
+                          in.sustain_guide_precision))
+            return false;
+        if (!r.nextDouble("terminal_guide_precision",
+                          in.terminal_guide_precision))
+            return false;
+        if (!r.nextDouble("boost_guide_lead", in.boost_guide_lead))
+            return false;
+        if (!r.nextDouble("sustain_guide_lead", in.sustain_guide_lead))
+            return false;
+        if (!r.nextDouble("terminal_guide_lead", in.terminal_guide_lead))
+            return false;
+        if (!r.nextDouble("boost_guide_gnav", in.boost_guide_gnav))
+            return false;
+        if (!r.nextDouble("sustain_guide_gnav", in.sustain_guide_gnav))
+            return false;
+        if (!r.nextDouble("terminal_guide_gnav", in.terminal_guide_gnav))
+            return false;
+        if (!r.nextDouble("boost_guide_bwap", in.boost_guide_bwap))
+            return false;
+        if (!r.nextDouble("sustain_guide_bwap", in.sustain_guide_bwap))
+            return false;
+        if (!r.nextDouble("terminal_guide_bwap", in.terminal_guide_bwap))
+            return false;
+    }
+
+    // ---- Aero section (readin.cpp:156-247) ----
+    f4::data::MissileAeroData& aero = ds.aero;
+    long numMach = 0, numAlpha = 0;
+    if (!r.nextInt("num_mach", numMach)) return false;
+    if (implausibleCount("num_mach", numMach, 1, 256)) {
+        errors.push_back(src + ": implausible mach breakpoint count " +
+                         std::to_string(numMach));
+        return false;
+    }
+    aero.mach.resize(static_cast<std::size_t>(numMach));
+    for (long i = 0; i < numMach; ++i) {
+        if (!r.nextDouble("mach breakpoint", aero.mach[static_cast<std::size_t>(i)]))
+            return false;
+    }
+    if (!r.nextInt("num_alpha", numAlpha)) return false;
+    if (implausibleCount("num_alpha", numAlpha, 1, 256)) {
+        errors.push_back(src + ": implausible alpha breakpoint count " +
+                         std::to_string(numAlpha));
+        return false;
+    }
+    aero.alpha.resize(static_cast<std::size_t>(numAlpha));
+    for (long i = 0; i < numAlpha; ++i) {
+        if (!r.nextDouble("alpha breakpoint",
+                          aero.alpha[static_cast<std::size_t>(i)]))
+            return false;
+    }
+    // CZ grid with multiplier folded in (readin.cpp:214-223).
+    aero.cz.assign(static_cast<std::size_t>(numMach),
+                   std::vector<double>(static_cast<std::size_t>(numAlpha), 0.0));
+    double mult = 1.0;
+    if (!r.nextDouble("cz multiplier", mult)) return false;
+    for (long i = 0; i < numMach; ++i) {
+        for (long j = 0; j < numAlpha; ++j) {
+            double v = 0.0;
+            if (!r.nextDouble("cz value", v)) return false;
+            aero.cz[static_cast<std::size_t>(i)][static_cast<std::size_t>(j)] =
+                v * mult;
+        }
+    }
+    // CX grid with multiplier folded in (readin.cpp:235-244).
+    aero.cx.assign(static_cast<std::size_t>(numMach),
+                   std::vector<double>(static_cast<std::size_t>(numAlpha), 0.0));
+    if (!r.nextDouble("cx multiplier", mult)) return false;
+    for (long i = 0; i < numMach; ++i) {
+        for (long j = 0; j < numAlpha; ++j) {
+            double v = 0.0;
+            if (!r.nextDouble("cx value", v)) return false;
+            aero.cx[static_cast<std::size_t>(i)][static_cast<std::size_t>(j)] =
+                v * mult;
+        }
+    }
+
+    // ---- Engine section (readin.cpp:249-289) ----
+    f4::data::MissileEngineData& eng = ds.engine;
+    long numBreaks = 0;
+    if (!r.nextInt("num_breaks", numBreaks)) return false;
+    if (implausibleCount("num_breaks", numBreaks, 1, 256)) {
+        errors.push_back(src + ": implausible engine breakpoint count " +
+                         std::to_string(numBreaks));
+        return false;
+    }
+    eng.times_s.resize(static_cast<std::size_t>(numBreaks));
+    for (long i = 0; i < numBreaks; ++i) {
+        if (!r.nextDouble("burn time breakpoint",
+                          eng.times_s[static_cast<std::size_t>(i)]))
+            return false;
+    }
+    eng.thrust_lbf.resize(static_cast<std::size_t>(numBreaks));
+    for (long i = 0; i < numBreaks; ++i) {
+        if (!r.nextDouble("thrust", eng.thrust_lbf[static_cast<std::size_t>(i)]))
+            return false;
+    }
+
+    // ---- Range section (readin.cpp:291-381) ----
+    // JPO's asserts bound every count 0 < n < 100 (readin.cpp:311-347);
+    // the port enforces them as hard errors (that is what makes the
+    // 39-field mis-shift on the shipped files DETECTABLE).
+    f4::data::MissileRangeData& range = ds.range;
+    double scale = 1.0;
+    if (!r.nextDouble("range scale", scale)) return false;
+    long numAlt = 0, numVel = 0, numAspect = 0;
+    if (!r.nextInt("num_alt", numAlt)) return false;
+    if (implausibleCount("num_alt", numAlt, 1, 99)) {
+        errors.push_back(src + ": implausible altitude breakpoint count " +
+                         std::to_string(numAlt) + " (JPO: 0 < n < 100)");
+        return false;
+    }
+    range.alt_breakpoints_ft.resize(static_cast<std::size_t>(numAlt));
+    for (long i = 0; i < numAlt; ++i) {
+        if (!r.nextDouble("altitude breakpoint",
+                          range.alt_breakpoints_ft[static_cast<std::size_t>(i)]))
+            return false;
+    }
+    if (!r.nextInt("num_vel", numVel)) return false;
+    if (implausibleCount("num_vel", numVel, 1, 99)) {
+        errors.push_back(src + ": implausible velocity breakpoint count " +
+                         std::to_string(numVel) + " (JPO: 0 < n < 100)");
+        return false;
+    }
+    range.vel_breakpoints_fps.resize(static_cast<std::size_t>(numVel));
+    for (long i = 0; i < numVel; ++i) {
+        if (!r.nextDouble("velocity breakpoint",
+                          range.vel_breakpoints_fps[static_cast<std::size_t>(i)]))
+            return false;
+    }
+    if (!r.nextInt("num_aspect", numAspect)) return false;
+    if (implausibleCount("num_aspect", numAspect, 1, 99)) {
+        errors.push_back(src + ": implausible aspect breakpoint count " +
+                         std::to_string(numAspect) + " (JPO: 0 < n < 100)");
+        return false;
+    }
+    range.aspect_breakpoints_rad.resize(static_cast<std::size_t>(numAspect));
+    for (long i = 0; i < numAspect; ++i) {
+        if (!r.nextDouble("aspect breakpoint",
+                          range.aspect_breakpoints_rad[static_cast<std::size_t>(i)]))
+            return false;
+    }
+    // readin.cpp:368-378: data[alt][vel][aspect], each x scaleFactor.
+    range.data_ft.assign(
+        static_cast<std::size_t>(numAlt),
+        std::vector<std::vector<double>>(
+            static_cast<std::size_t>(numVel),
+            std::vector<double>(static_cast<std::size_t>(numAspect), 0.0)));
+    for (long i = 0; i < numAlt; ++i) {
+        for (long j = 0; j < numVel; ++j) {
+            for (long k = 0; k < numAspect; ++k) {
+                double v = 0.0;
+                if (!r.nextDouble("range value", v)) return false;
+                range.data_ft[static_cast<std::size_t>(i)]
+                            [static_cast<std::size_t>(j)]
+                            [static_cast<std::size_t>(k)] = v * scale;
+            }
+        }
+    }
+
+    // Success: record where the token stream ended (for the aux tail).
+    lastTokenLine = r.pos > 0 ? r.tokens[r.pos - 1].line : 0;
+    return true;
+}
+
+// --- the aux tail: ParseSimlibFile over the lines after the tables ----
+
+void parseAuxTail(const std::string& source, std::size_t afterLine,
+                  f4::data::MissileAuxData& aux,
+                  std::vector<std::string>& warnings,
+                  const std::string& src) {
+    // Split into lines; only lines STRICTLY AFTER the last consumed
+    // token's line participate (the reference reads the file position
+    // after the last fscanf; ReadLine then runs to EOF).
+    std::vector<std::string> lines;
+    {
+        std::istringstream ss(source);
+        std::string line;
+        while (std::getline(ss, line)) lines.push_back(line);
+    }
+    for (std::size_t ln = afterLine; ln < lines.size(); ++ln) {
+        std::string line = lines[ln];
+        // Trim CR and leading whitespace (datafile.cpp:153-155).
+        while (!line.empty() && (line.back() == '\r' || line.back() == '\n'))
+            line.pop_back();
+        std::size_t b = 0;
+        while (b < line.size() &&
+               std::isspace(static_cast<unsigned char>(line[b])))
+            ++b;
+        if (b >= line.size() || line[b] == '#') continue;  // blank/comment
+
+        const std::string trimmed = line.substr(b);
+        // Key: first whitespace-delimited run; value: the rest.
+        std::size_t e = 0;
+        while (e < trimmed.size() &&
+               !std::isspace(static_cast<unsigned char>(trimmed[e])))
+            ++e;
+        const std::string rawKey = trimmed.substr(0, e);
+        const std::string key = lowercase(rawKey);
+        std::string value;
+        if (e < trimmed.size()) {
+            std::size_t vb = e;
+            while (vb < trimmed.size() &&
+                   std::isspace(static_cast<unsigned char>(trimmed[vb])))
+                ++vb;
+            value = trimmed.substr(vb);
+        }
+        if (value.empty()) continue;  // no value -> nothing to assign
+
+        // AssignField (datafile.cpp:17-133): int (incl. 0x hex), float,
+        // vector "x y z"/"x,y,z"; unknown key -> silently ignored
+        // (datafile.cpp:229-233).
+        auto assignInt = [&](int& target) {
+            long v = 0;
+            if (!value.empty() && value[0] == '0' &&
+                value.size() > 1 && (value[1] == 'x' || value[1] == 'X')) {
+                v = std::strtol(value.c_str(), nullptr, 16);
+            } else if (!atoiLike(value, v)) {
+                return;
+            }
+            target = static_cast<int>(v);
+        };
+        auto assignDouble = [&](double& target) {
+            double v = 0.0;
+            if (parseDouble(value, v)) target = v;
+        };
+
+        if (key == "fovlevel") assignDouble(aux.fov_level);
+        else if (key == "explevel") assignDouble(aux.exp_level);
+        else if (key == "wezmax") assignDouble(aux.wez_max_nm);
+        else if (key == "wezmin") assignDouble(aux.wez_min_nm);
+        else if (key == "maxgterminal") assignDouble(aux.max_g_terminal);
+        else if (key == "maxgnormal") assignDouble(aux.max_g_normal);
+        else if (key == "minengagementrange") assignDouble(aux.min_engagement_range);
+        else if (key == "minengagementalt") assignDouble(aux.min_engagement_alt);
+        else if (key == "proximityfusechange") assignDouble(aux.proximity_fuse_change);
+        else if (key == "secondstagetimer") assignDouble(aux.second_stage_timer_s);
+        else if (key == "secondstageweight") assignDouble(aux.second_stage_weight_lb);
+        else if (key == "deployablewingstime") assignDouble(aux.deployable_wings_time_s);
+        else if (key == "mistrail") assignInt(aux.missile_trail);
+        else if (key == "misengglow") assignInt(aux.engine_glow);
+        else if (key == "misengglowbsp") assignInt(aux.engine_glow_bsp);
+        else if (key == "misgroundglow") assignInt(aux.ground_glow);
+        else if (key == "proximityfuserange") assignInt(aux.proximity_fuse_range_ft);
+        else if (key == "errorfromparrent") assignInt(aux.error_from_parent);
+        else if (key == "englocation") {
+            // ID_VECTOR: "x y z" or "x,y,z" (datafile.cpp:71-82).
+            double x = 0.0, y = 0.0, z = 0.0;
+            std::string flat;
+            for (char c : value)
+                if (c != ',') flat.push_back(c);
+            std::istringstream vs(flat);
+            if (vs >> x >> y >> z) {
+                aux.engine_location_x = x;
+                aux.engine_location_y = y;
+                aux.engine_location_z = z;
+            }
+        }
+        else if (key == "enginesound") assignInt(aux.engine_sound);
+        else if (key == "rocketdispersionconeangle") assignDouble(aux.rocket_dispersion_cone_rad);
+        else if (key == "rocketsalvosize") assignInt(aux.rocket_salvo_size);
+        else if (key == "sndaim9growl") assignInt(aux.snd_aim9_growl);
+        else if (key == "sndaim9growllock") assignInt(aux.snd_aim9_growl_lock);
+        else if (key == "sndaim9uncaged") assignInt(aux.snd_aim9_uncaged);
+        else if (key == "sndaim9envirosky") assignInt(aux.snd_aim9_enviro_sky);
+        else if (key == "sndaim9enviroground") assignInt(aux.snd_aim9_enviro_ground);
+        else if (key == "pickletimedelay") assignInt(aux.pickle_time_delay_ms);
+        else if (key == "psgroundimpact") aux.ps_ground_impact = value;
+        else if (key == "psmissilekill") aux.ps_missile_kill = value;
+        else if (key == "psfeatureimpact") aux.ps_feature_impact = value;
+        else if (key == "psbombimpact") aux.ps_bomb_impact = value;
+        else if (key == "psarmingdelay") aux.ps_arming_delay = value;
+        else if (key == "psexceedfov") aux.ps_exceed_fov = value;
+        else if (key == "gimbaltrackfactor") assignDouble(aux.gimbal_track_factor);
+        else if (key == "launchsound") assignInt(aux.launch_sound);
+        else {
+            warnings.push_back(src + ": unknown aux key '" + rawKey +
+                               "' ignored (reference behavior: silent)");
+        }
+    }
+}
+
+std::string readFileToString(const std::string& path, bool& ok) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        ok = false;
+        return {};
+    }
+    std::stringstream ss;
+    ss << in.rdbuf();
+    ok = true;
+    return ss.str();
+}
+
+fs::path resolveInDir(const std::string& dir, const std::string& name) {
+    if (dir.empty()) return {};
+    const std::string want = lowercase(name);
+    std::error_code ec;
+    for (fs::directory_iterator it(dir, ec), end; it != end && !ec;
+         it.increment(ec)) {
+        if (!it->is_regular_file(ec)) continue;
+        if (lowercase(it->path().filename().string()) == want) {
+            return it->path();
+        }
+    }
+    return {};
+}
+
+} // namespace
+
+MissileFileParseResult loadMissileString(const std::string& contents,
+                                         const std::string& name,
+                                         const std::string& sourceName) {
+    MissileFileParseResult result;
+    result.dataset.name = name;
+
+    const auto tokens = tokenize(contents);
+    if (tokens.size() < 30) {
+        result.errors.push_back(sourceName +
+                                ": too few tokens for a missile dataset");
+        return result;
+    }
+
+    // Tokens after the sequential readers stop: those on LATER lines are
+    // the aux tail's domain (key-value lines, warned per unknown key);
+    // only tokens still ON the last consumed token's line are genuinely
+    // skipped-by-the-reference (fscanf leaves the position mid-line and
+    // the next ReadLine discards the rest of that line).
+    const auto countTrailingOnLastLine = [&](const ReaderState& r,
+                                              std::size_t lastLine) {
+        std::size_t n = 0;
+        for (std::size_t i = r.pos;
+             i < tokens.size() && tokens[i].line <= lastLine; ++i) {
+            ++n;
+        }
+        return n;
+    };
+
+    // Attempt 1: the FreeFalcon reader order (39 input fields). This is
+    // the primary because it IS the reference reader; when it validates,
+    // the file is a post-2002 format and the result is byte-faithful to
+    // ReadAllMissileData.
+    {
+        std::vector<std::string> attemptErrors;
+        ReaderState r{tokens, 0, attemptErrors, sourceName, false};
+        f4::data::MissileDataset attempt = result.dataset;
+        std::size_t lastLine = 0;
+        if (readAll(r, attempt, 39, sourceName, attemptErrors, lastLine)) {
+            attempt.input.format = "freefalcon39";
+            result.dataset = std::move(attempt);
+            parseAuxTail(contents, lastLine, result.dataset.aux,
+                         result.warnings, sourceName);
+            const std::size_t trailing = countTrailingOnLastLine(r, lastLine);
+            if (trailing > 0) {
+                result.warnings.push_back(
+                    sourceName + ": " + std::to_string(trailing) +
+                    " trailing token(s) on the range table's last line (the "
+                    "reference's next ReadLine discards the rest of that "
+                    "line)");
+            }
+            result.ok = true;
+            return result;
+        }
+    }
+
+    // Attempt 2: the legacy 24-field order (the shipped 1998 files).
+    // The fifteen "me123" guidance fields were absent from that era's
+    // data; they stay 0.0 (documented in missile_data.hpp).
+    {
+        std::vector<std::string> attemptErrors;
+        ReaderState r{tokens, 0, attemptErrors, sourceName, false};
+        f4::data::MissileDataset attempt = result.dataset;
+        std::size_t lastLine = 0;
+        if (readAll(r, attempt, 24, sourceName, attemptErrors, lastLine)) {
+            attempt.input.format = "legacy24";
+            result.dataset = std::move(attempt);
+            result.warnings.push_back(
+                sourceName +
+                ": legacy 24-field input format detected (the shipped 1998 "
+                "layout) — the FreeFalcon 39-field reader shifts 15 tokens "
+                "and reads garbage aero counts here; the fifteen me123 "
+                "guidance fields are 0.0");
+            parseAuxTail(contents, lastLine, result.dataset.aux,
+                         result.warnings, sourceName);
+            const std::size_t trailing = countTrailingOnLastLine(r, lastLine);
+            if (trailing > 0) {
+                result.warnings.push_back(
+                    sourceName + ": " + std::to_string(trailing) +
+                    " trailing token(s) on the range table's last line (the "
+                    "reference's next ReadLine discards the rest of that "
+                    "line)");
+            }
+            result.ok = true;
+            return result;
+        }
+        result.errors = std::move(attemptErrors);
+    }
+
+    return result;
+}
+
+MissileFileParseResult loadMissileFile(const std::string& path) {
+    MissileFileParseResult result;
+    bool ok = false;
+    const std::string contents = readFileToString(path, ok);
+    if (!ok) {
+        result.errors.push_back("cannot open " + path);
+        return result;
+    }
+    const std::string stem = fs::path(path).stem().string();
+    return loadMissileString(contents, stem, path);
+}
+
+MissileDirParseResult loadMissileDataDir(const std::string& dir) {
+    MissileDirParseResult result;
+
+    // MISTYPES.LST: count + stems (readin.cpp:39-43: GetNext for the
+    // count, then ReadLine per entry).
+    const fs::path lstPath = resolveInDir(dir, "MISTYPES.LST");
+    if (lstPath.empty()) {
+        result.errors.push_back("cannot find MISTYPES.LST in '" + dir + "'");
+        return result;
+    }
+    bool ok = false;
+    const std::string lstContents = readFileToString(lstPath.string(), ok);
+    if (!ok) {
+        result.errors.push_back("cannot open " + lstPath.string());
+        return result;
+    }
+    const auto lstTokens = tokenize(lstContents);
+    if (lstTokens.empty()) {
+        result.errors.push_back(lstPath.string() + ": no tokens (empty?)");
+        return result;
+    }
+    long count = 0;
+    if (!atoiLike(lstTokens[0].text, count) || count < 0 || count > 1024) {
+        result.errors.push_back(lstPath.string() + ": bad dataset count '" +
+                                lstTokens[0].text + "'");
+        return result;
+    }
+    if (lstTokens.size() < 1 + static_cast<std::size_t>(count)) {
+        result.errors.push_back(lstPath.string() + ": expected " +
+                                std::to_string(count) + " stems, found " +
+                                std::to_string(lstTokens.size() - 1));
+        return result;
+    }
+    // The 26/28 quirk: every stem beyond the declared count is a dead
+    // file in the shipped zip (readin.cpp's loop is count-driven).
+    if (lstTokens.size() > 1 + static_cast<std::size_t>(count)) {
+        std::string dead;
+        for (std::size_t i = 1 + static_cast<std::size_t>(count);
+             i < lstTokens.size(); ++i) {
+            if (!dead.empty()) dead += ", ";
+            dead += lstTokens[i].text;
+        }
+        result.warnings.push_back(
+            lstPath.string() + ": " +
+            std::to_string(lstTokens.size() - 1 -
+                           static_cast<std::size_t>(count)) +
+            " stem(s) beyond the declared count are never read (the "
+            "reference loop is count-driven): " + dead);
+    }
+
+    for (long i = 0; i < count; ++i) {
+        const std::string stem = lstTokens[1 + static_cast<std::size_t>(i)].text;
+        const fs::path file = resolveInDir(dir, stem + ".dat");
+        if (file.empty()) {
+            result.errors.push_back("cannot find '" + stem +
+                                    ".dat' in '" + dir + "'");
+            return result;
+        }
+        auto parsed = loadMissileFile(file.string());
+        if (!parsed.ok) {
+            result.errors.insert(result.errors.end(),
+                                 parsed.errors.begin(), parsed.errors.end());
+            return result;
+        }
+        result.warnings.insert(result.warnings.end(),
+                               parsed.warnings.begin(),
+                               parsed.warnings.end());
+        result.library.entries.push_back(std::move(parsed.dataset));
+    }
+
+    result.ok = true;
+    return result;
+}
+
+} // namespace f4::convert
