+    auto r = loadMissileDataLibrary(
+        F4_GENERATED_FIXTURES_DIR "/simdata/misdata.json");
+    ASSERT_TRUE(r.ok);
+    const auto* m9 = r.library.find("aim9l");
+    const auto* m120 = r.library.find("aim120");
+    ASSERT_NE(m9, nullptr);
+    ASSERT_NE(m120, nullptr);
+    const MissileConfig c9 = MissileConfig::from_simdata(*m9);
+    const MissileConfig c120 = MissileConfig::from_simdata(*m120);
+    EXPECT_GT(c120.launch_mass_lb, c9.launch_mass_lb);   // 428 vs 216 lb
+    EXPECT_GT(c120.tof_limit_s, c9.tof_limit_s);         // 84 vs 10 s
+    EXPECT_GT(c120.seeker_max_range_ft, c9.seeker_max_range_ft);
+}
