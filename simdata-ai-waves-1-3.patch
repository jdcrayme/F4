+// f4-weapons/tests/test_missile_simdata.cpp
+//
+// MissileConfig::from_simdata() — the SimData MISDATA consumer. Proves
+// the mapping from the real missile datasets (wm0/wp0 masses, engine
+// table, cx sign convention, WEZ envelope, aux defaults) into the pure
+// flyout config, then flies a real-data round.
+//
+// Fixture: ${F4_GENERATED_FIXTURES_DIR}/simdata/misdata.json (generated
+// by msl2json from the shipped sim/MISDATA files).
+
+#include <f4/weapons/missile.hpp>
+
+#include <f4/data/missile_data.hpp>
+
+#include <gtest/gtest.h>
+
+#include <cmath>
+
+using namespace f4::weapons;
+using namespace f4::data;
+
+namespace {
+
+constexpr double kDeg2Rad = 0.017453292519943295;
+
+// A synthetic dataset with hand-computable from_simdata results.
+MissileDataset syntheticDataset() {
+    MissileDataset ds;
+    ds.name = "synthetic";
+    ds.input.format = "freefalcon39";
+    ds.input.wm0_lb = 100.0;
+    ds.input.wp0_lb = 50.0;
+    ds.input.area_ft2 = 0.2;
+    ds.input.nav_gain = 3.0;
+    ds.input.seeker_fov_rad = 8.0 * kDeg2Rad;
+    ds.input.max_tof_s = 30.0;
+    // Motor: 0->2000 lbf in 1 s, flat to 3 s, 0 at 4 s.
+    // Trapezoid: 0.5*(0+2000)*1 + 2000*2 + 0.5*(2000+0)*1 = 6000 lb-s.
+    ds.engine.times_s = {0.0, 1.0, 3.0, 4.0};
+    ds.engine.thrust_lbf = {0.0, 2000.0, 2000.0, 0.0};
+    // cx(1, 0): mach axis {0,2}, alpha {0,10}; cx[0][0] = -0.3,
+    // cx[1][0] = -0.5 -> bilinear at mach 1 = -0.4 -> cd 0.4.
+    ds.aero.mach = {0.0, 2.0};
+    ds.aero.alpha = {0.0, 10.0};
+    ds.aero.cx = {{-0.3, -0.4}, {-0.5, -0.6}};
+    ds.aero.cz = {{0.0, -1.0}, {0.0, -2.0}};
+    // WEZ: max 40000 ft.
+    ds.range.alt_breakpoints_ft = {0.0, 20000.0};
+    ds.range.vel_breakpoints_fps = {0.0, 1000.0};
+    ds.range.aspect_breakpoints_rad = {0.0, 3.14};
+    ds.range.data_ft = {{{10000.0, 20000.0}, {30000.0, 40000.0}},
+                        {{10000.0, 20000.0}, {30000.0, 35000.0}}};
+    // aux: all reader defaults except the fuze.
+    ds.aux.proximity_fuse_range_ft = 800;
+    return ds;
+}
+
+} // namespace
+
+// ============================================================================
+// The mapping (every field, hand-computed)
+// ============================================================================
+
+TEST(MissileSimData, FromSimdataMapsEveryField) {
+    const MissileConfig c = MissileConfig::from_simdata(syntheticDataset());
+
+    // readin.cpp:18-27: weight = wm0 + wp0; burnout weight = wm0.
+    EXPECT_DOUBLE_EQ(c.launch_mass_lb, 150.0);
+    EXPECT_DOUBLE_EQ(c.burnout_mass_lb, 100.0);
+
+    // Burn time = last engine breakpoint; thrust = impulse / burn time
+    // (6000 / 4 = 1500).
+    EXPECT_DOUBLE_EQ(c.burn_time_s, 4.0);
+    EXPECT_NEAR(c.thrust_lbf, 1500.0, 1e-9);
+
+    // cd = -cx(mach 1, alpha 0) = 0.4 (shipped cx is negative for drag,
+    // aero.cpp:53); area straight from the input section.
+    EXPECT_DOUBLE_EQ(c.ref_area_ft2, 0.2);
+    EXPECT_NEAR(c.cd, 0.4, 1e-12);
+
+    // Terminal speed = sqrt(2T / (rho0 cd A)) at sea level.
+    const double vTerm =
+        std::sqrt(2.0 * 1500.0 / (0.0023769 * 0.4 * 0.2));
+    EXPECT_NEAR(c.max_speed_fts, vTerm, 1e-9);
+
+    // PN gain, seeker cone (radians already), WEZ-max seeker range.
+    EXPECT_DOUBLE_EQ(c.guidance_gain, 3.0);
+    EXPECT_NEAR(c.seeker_half_angle_rad, 8.0 * kDeg2Rad, 1e-15);
+    EXPECT_DOUBLE_EQ(c.seeker_max_range_ft, 40000.0);
+
+    // Fuze from aux; lethality is WCD data (0 until the host sets it);
+    // self-destruct at maxTof.
+    EXPECT_DOUBLE_EQ(c.fuze_radius_ft, 800.0);
+    EXPECT_DOUBLE_EQ(c.lethal_radius_ft, 0.0);
+    EXPECT_DOUBLE_EQ(c.tof_limit_s, 30.0);
+
+    // G limit: aux maxGNormal reader default.
+    EXPECT_DOUBLE_EQ(c.max_g, 40.0);
+}
+
+TEST(MissileSimData, NegativeCxMeansDrag) {
+    // A positive cx entry must clamp to zero drag, not invert the model.
+    MissileDataset ds = syntheticDataset();
+    ds.aero.cx = {{+0.3, +0.4}, {+0.5, +0.6}};
+    const MissileConfig c = MissileConfig::from_simdata(ds);
+    EXPECT_DOUBLE_EQ(c.cd, 0.0);
+    EXPECT_DOUBLE_EQ(c.max_speed_fts, 0.0);  // not derivable
+}
+
+TEST(MissileSimData, EmptyMotorAndTablesDegradeGracefully) {
+    MissileDataset ds;  // everything default/empty
+    const MissileConfig c = MissileConfig::from_simdata(ds);
+    EXPECT_DOUBLE_EQ(c.burn_time_s, 0.0);
+    EXPECT_DOUBLE_EQ(c.thrust_lbf, 0.0);
+    EXPECT_DOUBLE_EQ(c.cd, 0.0);
+    EXPECT_DOUBLE_EQ(c.max_speed_fts, 0.0);
+    EXPECT_DOUBLE_EQ(c.seeker_max_range_ft, 0.0);
+    EXPECT_DOUBLE_EQ(c.fuze_radius_ft, 1000.0);  // aux default
+    EXPECT_DOUBLE_EQ(c.max_g, 40.0);
+}
+
+// ============================================================================
+// The shipped fixture (end-to-end)
+// ============================================================================
+
+#ifdef F4_GENERATED_FIXTURES_DIR
+
+TEST(MissileSimDataFixture, Aim9lConfigFromRealData) {
+    auto r = loadMissileDataLibrary(
+        F4_GENERATED_FIXTURES_DIR "/simdata/misdata.json");
+    ASSERT_TRUE(r.ok) << (r.errors.empty() ? "no errors" : r.errors[0]);
+    const auto* m = r.library.find("aim9l");
+    ASSERT_NE(m, nullptr);
+    const MissileConfig c = MissileConfig::from_simdata(*m);
+
+    EXPECT_DOUBLE_EQ(c.launch_mass_lb, 215.799999);
+    EXPECT_DOUBLE_EQ(c.burnout_mass_lb, 169.0);
+    EXPECT_DOUBLE_EQ(c.burn_time_s, 3.72);
+    // aim9l motor: 4300 lbf boost spike, ~1970 sustain. The
+    // impulse-equivalent constant sits between.
+    EXPECT_GT(c.thrust_lbf, 1900.0);
+    EXPECT_LT(c.thrust_lbf, 4300.0);
+    EXPECT_NEAR(c.seeker_half_angle_rad, 6.0 * kDeg2Rad, 1e-12);
+    EXPECT_DOUBLE_EQ(c.guidance_gain, 4.0);
+    EXPECT_DOUBLE_EQ(c.tof_limit_s, 10.0);
+    // aim9l cx at mach 1 (between the 0 and 4 breakpoints, alpha 0):
+    // -1.10 everywhere -> cd 1.10.
+    EXPECT_NEAR(c.cd, 1.10, 1e-9);
+    // WEZ max: 2x 6076.16 = 12152.38 ft.
+    EXPECT_NEAR(c.seeker_max_range_ft, 12152.38, 1e-2);
+}
+
+TEST(MissileSimDataFixture, Aim9lFliesAndTerminates) {
+    auto r = loadMissileDataLibrary(
+        F4_GENERATED_FIXTURES_DIR "/simdata/misdata.json");
+    ASSERT_TRUE(r.ok);
+    const auto* m = r.library.find("aim9l");
+    ASSERT_NE(m, nullptr);
+    MissileConfig c = MissileConfig::from_simdata(*m);
+    // Lethality is the host's job (WCD data): set it so the proximity
+    // fuze can work.
+    c.lethal_radius_ft = 40.0;
+
+    Missile ms;
+    f4::geo::WorldPosition pos{};
+    pos.x = 0.0;
+    pos.y = 0.0;
+    pos.z = 1000.0;
+    const f4::math::Vec3<double> vel{1200.0, 0.0, 0.0};
+    ms.launch(c, pos, vel);
+
+    TargetSnapshot tgt;
+    tgt.valid = true;
+    tgt.position.x = 8000.0;
+    tgt.position.y = 0.0;
+    tgt.position.z = 1000.0;
+
+    bool everGuided = false, terminated = false;
+    double prevSpeed = 1200.0;
+    bool accelerated = false;
+    for (int i = 0; i < 4000 && !ms.terminal(); ++i) {
+        ms.tick(0.01, tgt);
+        if (ms.status() == MissileStatus::Guided) everGuided = true;
+        if (ms.velocity().length() > prevSpeed + 1e-9) accelerated = true;
+        prevSpeed = ms.velocity().length();
+        terminated = ms.terminal();
+    }
+    // The real motor pushes the round past its launch speed...
+    EXPECT_TRUE(accelerated);
+    // ...guidance holds lock for at least a while...
+    EXPECT_TRUE(everGuided);
+    // ...and the round terminates (fuze or maxTof = 10 s = 1000 ticks).
+    EXPECT_TRUE(terminated);
+}
+
