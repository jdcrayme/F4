+std::string writeMissileDataLibrary(const MissileDataLibrary& lib) {
+    json j;
+    j["kind"] = "f4.misdata";
+    j["version"] = 1;
+    json arr = json::array();
+    for (const auto& e : lib.entries) {
+        arr.push_back({
+            {"name", e.name},
+            {"input", inputToJson(e.input)},
+            {"aero", aeroToJson(e.aero)},
+            {"engine", engineToJson(e.engine)},
+            {"range", rangeToJson(e.range)},
+            {"aux", auxToJson(e.aux)},
+        });
+    }
+    j["missiles"] = std::move(arr);
+    return j.dump(2) + "\n";
+}
+
+bool writeMissileDataLibraryFile(const MissileDataLibrary& lib,
+                                 const std::string& path) {
+    std::ofstream out(path, std::ios::binary);
+    if (!out) return false;
+    out << writeMissileDataLibrary(lib);
+    return out.good();
+}
+
+MissileDataResult loadMissileDataLibraryFromString(
+    const std::string& contents) {
+    MissileDataResult result;
+    json j = json::parse(contents, nullptr, false);
+    if (j.is_discarded()) {
+        result.errors.push_back("invalid JSON");
+        return result;
+    }
+    const std::string kind = j.value("kind", "");
+    if (kind != "f4.misdata" && kind != "misdata") {
+        result.errors.push_back("wrong kind tag: '" + kind + "'");
+        return result;
+    }
+    for (const auto& je : j.value("missiles", json::array())) {
+        MissileDataset e;
+        e.name = je.value("name", "");
+        if (je.contains("input")) e.input = inputFromJson(je["input"]);
+        if (je.contains("aero")) e.aero = aeroFromJson(je["aero"]);
+        if (je.contains("engine")) e.engine = engineFromJson(je["engine"]);
+        if (je.contains("range")) e.range = rangeFromJson(je["range"]);
+        if (je.contains("aux")) e.aux = auxFromJson(je["aux"]);
+        result.library.entries.push_back(std::move(e));
+    }
+    result.ok = true;
+    return result;
+}
+
+MissileDataResult loadMissileDataLibrary(const std::string& path) {
+    MissileDataResult result;
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        result.errors.push_back("cannot open " + path);
+        return result;
+    }
+    std::stringstream ss;
+    ss << in.rdbuf();
+    return loadMissileDataLibraryFromString(ss.str());
+}
