index 0000000..3511df1
--- /dev/null
+++ b/f4-convert/include/f4/convert/missile_parser.hpp
@@ -0,0 +1,75 @@
+// f4-convert/missile_parser.hpp
+//
+// Parser for the legacy FreeFalcon missile datasets in SimData.zip's
+// sim/MISDATA tree (the last data family with a real runtime reader):
+//   - MISTYPES.LST          — one count + one missile stem per line
+//   - <stem>.dat            — five sequential sections over one token
+//                             stream: Input -> Aero -> Engine -> Range ->
+//                             Aux (readin.cpp:51-66).
+//
+// Token semantics (SimlibFileClass::GetNext, file.cpp:411-441):
+// whitespace-delimited tokens; a token starting with '#' or ';' skips the
+// rest of its line. The Aux section instead reads whole lines
+// (ParseSimlibFile, datafile.cpp:215-237): '#' leading lines skipped,
+// "key value..." split on whitespace, case-insensitive key match,
+// unknown keys silently ignored, all fields defaulted first.
+//
+// FORMAT QUIRK (documented, load-bearing): the shipped 1998 .dat files
+// carry the ORIGINAL 24-field input section; the FreeFalcon reader
+// consumes 39 (fifteen "me123" guidance fields were added to the reader
+// after the files were authored — reader order: readin.cpp:132-151).
+// Run against these files the reference reader shifts the aero read by
+// fifteen tokens and produces garbage (negative alpha counts on every
+// shipped file — the aim9l aero becomes numMach=44/numAlpha=-56). The
+// parser auto-detects: parse the 39-field order first; when the
+// sequential validation fails, re-parse in the legacy 24-field order
+// with the fifteen guidance fields = 0.0 and a warning recording the
+// detected format. MissileInputData::format carries the result.
+//
+// LIST QUIRK: MISTYPES.LST declares 26 entries but lists 28 stems — the
+// reference loop reads exactly the declared count, so sa8.dat and
+// sa15.dat are DEAD FILES in the shipped zip (present, unreachable).
+// The parser mirrors the count-driven loop and warns about every
+// trailing stem (readin.cpp:43,51-53).
+
+#pragma once
+
+#include "f4/data/missile_data.hpp"
+
+#include <string>
+#include <vector>
+
+namespace f4::convert {
+
+// Result of parsing one missile .dat file.
+struct MissileFileParseResult {
+    f4::data::MissileDataset dataset;
+    std::vector<std::string> warnings;
+    std::vector<std::string> errors;
+    bool ok = false;
+};
+
+// Result of parsing a whole MISDATA directory.
+struct MissileDirParseResult {
+    f4::data::MissileDataLibrary library;
+    std::vector<std::string> warnings;
+    std::vector<std::string> errors;
+    bool ok = false;
+};
+
+/// Parse one .dat file from disk.
+[[nodiscard]] MissileFileParseResult loadMissileFile(const std::string& path);
+
+/// Parse one .dat file from an in-memory string (tests). `name` labels
+/// the dataset (the MISTYPES.LST stem).
+[[nodiscard]] MissileFileParseResult loadMissileString(
+    const std::string& contents, const std::string& name,
+    const std::string& sourceName = "<string>");
+
+/// Parse a MISDATA directory: <dir>/MISTYPES.LST + <stem>.dat per entry
+/// (exactly the declared count; trailing stems warned, mirroring
+/// readin.cpp:43-53).
+[[nodiscard]] MissileDirParseResult loadMissileDataDir(
+    const std::string& dir);
+
+} // namespace f4::convert
