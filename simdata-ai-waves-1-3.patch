+double VisualSensorData::nominal_range_nm() const noexcept {
+    // signal = gain / range_ft^2 >= 1  ->  range_ft = sqrt(gain)
+    return std::sqrt(std::max(gain, 0.0)) / kSensorFeetPerNm;
+}
