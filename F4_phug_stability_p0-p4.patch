+    in.position = f4::geo::WorldPosition(s.kin.y, s.kin.x, -s.kin.z);
+    in.heading_rad = f4::flight::to_radians(s.kin.psi);
+    in.pitch_rad    = f4::flight::to_radians(s.kin.theta);
