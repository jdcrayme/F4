+    // 0 (= the authored default pose) when unbound or no instance
+    // state.
+    float value = 0.0f;
+    if (anim_node && anim_node->kind == "dof" && anim &&
+        !anim_node->channel.empty()) {
+        if (auto ch = f4::anim::channel_from_name(anim_node->channel)) {
+            value = (*anim)[*ch];
+        }
+    }
