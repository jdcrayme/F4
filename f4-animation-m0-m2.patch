+        } else if (key == "scale_target") {
+            f.scale_target = read_fixed_array<3>(r);
+        } else if (key == "reversed") {
+            // BXSwitchNode XSWT_REVERSED_EFFECT: the mask is inverted.
+            f.reversed = r.read_bool();
         } else {
             r.skip_value();
         }
