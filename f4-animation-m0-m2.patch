+/// Compose one chain node's local matrix for this frame.
+Matrix anim_node_local_matrix(const f4::gltf::GltfDocument& doc,
+                              std::size_t node_index,
+                              const f4::anim::AnimValues* anim,
+                              const f4::gltf::AnimNode* anim_node) {
