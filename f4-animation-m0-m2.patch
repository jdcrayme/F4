+        // --- Tab 3: Anim Doctor (animation channel actuation) -----------
+        if (ImGui::BeginTabItem("Anim Doctor")) {
+            draw_model_doctor();
+            ImGui::EndTabItem();
+        }
         ImGui::EndTabBar();
     }
     ImGui::End();
