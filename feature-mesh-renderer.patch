+
+    f4::renderer::TextureCache tex_cache;
+    f4::renderer::LitShader lit_shader;
+    std::unordered_map<int, f4::renderer::FeatureMeshCacheEntry> mesh_cache;
+    ::Material default_mat = LoadMaterialDefault();
+
