+    tex_cache.unload_all();
+    for (auto& [_, entry] : mesh_cache) {
+        for (auto& me : entry.meshes) {
+            UnloadMesh(me.mesh);
+        }
+    }
+    UnloadMaterial(default_mat);
+}
